# systemd unit for pytest-board
#   sudo cp pytest-board.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pytest-board
#   journalctl -u pytest-board -f
[Unit]
Description=pytest-board (drag & drop pytest scheduler)
After=network-online.target
Wants=network-online.target

[Service]
# Run as the user that normally runs your tests. For remote machines, this user's
# ~/.ssh keys and ~/.ssh/config are what the board uses to connect.
User=tester
WorkingDirectory=/opt/pytest-board
Environment=PYTEST_BOARD_TOKEN=change-me
ExecStart=/usr/bin/python3 /opt/pytest-board/server.py \
    --root /home/tester/my-project \
    --host 0.0.0.0 --port 8765
# headlines are read from /home/tester/my-project/pytest-board.ini by default;
# add  --groups /etc/pytest-board/headlines.ini  above to keep the file elsewhere.
# The board's data (database, logs) goes in /opt/pytest-board/.pytest-board, so tester must be able to write
# there (sudo chown -R tester /opt/pytest-board), or add  --data /home/tester/.pytest-board  above.
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
